[Unit]
Description=Refresh policy in LightDM's private PAM view
Documentation=https://github.com/archledger/irlume

[Service]
Type=oneshot
ExecStart=/usr/bin/irlume login lightdm-refresh
# Allow the same cold executable and configuration reads as preparation.
TimeoutStartSec=90s
KillMode=control-group
PrivateDevices=yes
PrivateTmp=yes
