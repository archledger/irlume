[Unit]
Description=Re-apply irlume face-auth PAM wiring after a distro update
Documentation=https://github.com/archledger/irlume
# Runs from TWO triggers: the irlume-reconcile.path unit (a greeter PAM file
# changed) AND at boot (WantedBy below), so a strip that landed while the path
# watcher was inactive (an offline dnf/apt upgrade, or before paths.target on a
# first install) is still caught on the next boot. No ConditionPathExists: the
# command self-gates. With no marker it either ADOPTS an existing wiring into a
# marker (an upgrade from a pre-marker version) or exits; with a marker it
# re-applies the recorded wiring when a surface lost it, and rebuilds an
# /etc/pam.d override irlume made from a vendor file when that vendor file
# changed and nobody edited the override (one with an administrator's lines is
# never rebuilt). Idempotent; the password stays the fallback throughout.

[Service]
Type=oneshot
ExecStart=/usr/bin/irlume login reconcile
# A oneshot has no start timeout by default: a run that never finished kept
# the unit activating, and later path or timer triggers did nothing. Five
# minutes covers a re-apply that loads the SELinux module and restarts
# irlumed, including a wait of up to a minute for the PAM lock of an earlier
# irlume release still running during an upgrade. A run stopped at the limit
# changes nothing further; the next path or timer trigger, or the next boot,
# runs it again.
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
