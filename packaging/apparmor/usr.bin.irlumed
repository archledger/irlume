# AppArmor profile for the irlume face-authentication daemon (Debian/Ubuntu
# parity with the enforced Fedora SELinux module in packaging/selinux/).
#
# ENFORCE by default. Soak-validated 2026-07-09 on Ubuntu 26.04 (ThinkPad X13,
# TPM + IR/RGB camera): the profile loaded in complain first and every auth
# path (doctor, identify, enroll, keyring arm/TPM seal, diag, pamtester
# UnsealPassword) produced ZERO would-be-denials, then ran clean under enforce.
# A policy gap here degrades face auth to the password (irlume never locks out),
# so enforce is fail-safe; still soak new hardware/derivatives in complain
# before trusting enforce there (drop in `flags=(complain)` below to do so).
#
# Reload:  apparmor_parser -r /etc/apparmor.d/usr.bin.irlumed
# Complain (per-box soak):  add `flags=(complain)` to the profile line + reload.

abi <abi/4.0>,
include <tunables/global>

profile irlumed /usr/bin/irlumed flags=(attach_disconnected) {
  include <abstractions/base>
  # uid→name lookups for SO_PEERCRED authz (/etc/nsswitch.conf, passwd, group).
  include <abstractions/nameservice>
  # On systemd-userdbd systems (Ubuntu 26.04+, systemd-homed) glibc's `systemd`
  # NSS module resolves uid→name through the userdb varlink socket. Without this
  # every SO_PEERCRED lookup logs an AppArmor denial (files still resolves a
  # normal /etc/passwd user, but a userdb-only/homed user would fail authz). The
  # nameservice abstraction predates userdb and does not cover it.
  /run/systemd/userdb/ r,
  /run/systemd/userdb/* rw,

  # The systemd watchdog (WatchdogSec in the unit) is answered by writing
  # WATCHDOG=1 to this datagram socket. It is a PATHNAME socket, so AppArmor
  # mediates it and abstractions/base does not cover it: without this rule every
  # ping is denied, the daemon looks wedged to systemd, and it is killed and
  # restarted every WatchdogSec forever. The profile predates the watchdog, so
  # its enforce soak proves nothing about this path.
  /run/systemd/notify w,

  /usr/bin/irlumed mr,

  # Device-class enumeration (camera discovery walks /sys/class).
  /sys/class/ r,
  /sys/class/*/ r,

  # ONNX Runtime (mmap-exec): system lib dirs, a versioned /opt install, or the
  # bundled runtime under /usr/share (ORT_DYLIB_PATH is set per-distro).
  /usr/lib{,64}/libonnxruntime*.so* mr,
  /usr/local/lib/libonnxruntime*.so* mr,
  /opt/irlume/onnxruntime/lib/libonnxruntime*.so* mr,
  /opt/onnxruntime-*/lib/libonnxruntime*.so* mr,
  /usr/share/irlume/onnxruntime/lib/libonnxruntime*.so* mr,

  # Models: packaged location or a hand-installed repo checkout.
  /usr/share/irlume/models/*.onnx r,
  /home/*/irlume/models/*.onnx r,

  # Cameras: capture nodes + the sysfs identity walk of the anti-injection
  # camera pinning (canonicalized device path, USB ids, privacy switch).
  # The /dev/ directory read is the discovery walk (discover_nodes lists
  # /dev to find video nodes); without it, capabilities() sees no cameras
  # from inside the daemon while sysfs-based selection still works, and the
  # engine mis-tiers (found enforcing on Arch, 2026-08-05; issues #281/#283).
  /dev/ r,
  /dev/video[0-9]* rw,
  /sys/class/video4linux/ r,
  /sys/class/video4linux/** r,
  /sys/devices/** r,

  # IPC socket (thin PAM module and CLI connect here; SO_PEERCRED authz).
  /run/irlume.sock rw,

  # The emitter undo-journal's per-camera lock (flock over the whole
  # check/act window; emitter_journal.rs). Lives under /run/lock because a
  # lock's lifetime is a boot. 'k' is the flock permission; without these
  # rules the daemon refuses to drive the IR emitter and logs the #283
  # warning on every start. The profile's 2026-07-09 soak predates the
  # journal (0.8.x), which is how the gap shipped.
  /run/lock/ rw,
  /run/lock/irlume-emitter-*.lock rwk,

  # The per-stream emitter bookkeeping lock is a flock too, and it lives
  # under the state dir, whose ** rule grants rw WITHOUT the flock 'k'
  # permission. Fixing the /run/lock rule above unmasked this one on the
  # same machine, one restart later: locks need naming wherever they live.
  /var/lib/irlume/ir-emitter-stream/*.lock rwk,

  # TPM (template-key sealing, keyring unlock).
  /dev/tpmrm[0-9] rw,
  /dev/tpm[0-9] rw,

  # systemd signed-PCR policy artifacts (Tier-1 unseal on signed-UKI boxes;
  # absent on GRUB installs, where the read is existence-gated).
  /{etc,run,usr/lib}/systemd/tpm2-pcr-signature.json r,
  /{etc,run,usr/lib}/systemd/tpm2-pcr-public-key.pem r,

  # Config + state: enrollments (per-user), template keys, recovery blobs.
  /etc/irlume/ r,
  /etc/irlume/** rw,
  /home/*/.local/share/irlume/ rw,
  /home/*/.local/share/irlume/** rw,
  /var/lib/irlume/ rw,
  /var/lib/irlume/** rw,

  # Camera-busy diagnostics name the process holding the device (readdir /proc,
  # readlink each fd to find who holds the camera node, read its comm).
  /proc/ r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  /proc/[0-9]*/comm r,

  # The daemon reads its OWN confinement label + whether AppArmor is live so it
  # can report real confinement in Health (the TUI shows enforce/complain/
  # unconfined instead of guessing from the on-disk profile file). Under enforce
  # these reads are themselves mediated, so without these rules the daemon cannot
  # even tell it is confined and would report "unknown". /proc/self resolves to
  # its own pid, matched by the numeric glob.
  /sys/module/apparmor/parameters/enabled r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/attr/apparmor/current r,

  # Reading another user's state dir as the root daemon.
  capability dac_override,
  capability dac_read_search,
}
