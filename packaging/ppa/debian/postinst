#!/bin/sh
set -e

case "$1" in
    configure)
        # Create the setgid lock directory (#542) BEFORE debhelper starts or
        # restarts the unit below: the first lock the daemon creates sets the
        # group it will keep, and a fresh install has had no boot to apply the
        # tmpfiles.d rule yet.
        systemd-tmpfiles --create irlume.conf || true
        # Load the AppArmor profile (enforces, soak-validated - see the profile
        # header). Runs before the debhelper-inserted section starts or restarts
        # the unit, so the daemon is confined at exec time on both fresh install
        # and upgrade. (Do not write the debhelper token inside this comment: it
        # is substituted at build time and would split the comment.)
        if command -v apparmor_parser >/dev/null 2>&1; then
            apparmor_parser -r /etc/apparmor.d/usr.bin.irlumed 2>/dev/null || true
        fi
        cat <<'MSG'
irlume installed. Next steps:
  irlume tui                         # enroll your face + configure
  sudo irlume login enable --apply   # opt-in: wire greeter/lock screen
(most Hello cameras need no emitter step; if IR frames stay dark,
 sudo irlume ir-setup writes to the camera and tells you so first)
Password login remains available when face authentication is retry-limited.
MSG
        ;;
esac

#DEBHELPER#

# --no-start keeps upgrades from activating a deliberately stopped daemon.
# Restore first-install startup after debhelper's enablement and reload, while
# honoring policy-rc.d and avoiding runtime actions for an offline target root.
if [ "$1" = configure ] && [ -z "${2:-}" ] &&
   [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke start irlumed.service irlumed.socket >/dev/null || true
fi

exit 0
