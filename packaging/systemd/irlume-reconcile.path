[Unit]
Description=Watch greeter PAM files and re-apply irlume face-auth wiring
Documentation=https://github.com/archledger/irlume

[Path]
# A distro update (authselect, pam-auth-update, or a fresh vendor PAM file from
# a package upgrade) can silently strip irlume's lines from a greeter stack,
# leaving face login mysteriously dead until the next manual `login enable`.
# Watch every PAM file irlume can wire (keep in sync with GREETERS +
# FP_GREETERS + LOCKSCREEN + CINNAMON_LOCKSCREEN + OMARCHY_LOCKSCREEN in
# pamwire.rs); any modification triggers a
# reconcile, which is a no-op unless the wiring actually went missing. A vendor
# file changing under /usr/lib/pam.d is not watched here: the timer finds it,
# since package updates replace files by rename, which a watch misses anyway.
PathModified=/etc/pam.d/gdm-password
PathModified=/etc/pam.d/gdm-fingerprint
PathModified=/etc/pam.d/sddm
PathModified=/etc/pam.d/lightdm
PathModified=/etc/pam.d/plasmalogin
PathModified=/etc/pam.d/cosmic-greeter
PathModified=/etc/pam.d/greetd
PathModified=/etc/pam.d/ly
PathModified=/etc/pam.d/kde
PathModified=/etc/pam.d/cinnamon-screensaver
PathModified=/etc/pam.d/polkit-1
# The Omarchy lock pair (#607): the dedicated face lane appearing must yield
# the stock password lane, and it disappearing must reclaim it. The timer
# backstop covers the cases a file watch cannot see (renames, and possibly
# deletion of the face lane file; systemd does not document waking Path
# units for a watched file's removal).
PathModified=/etc/pam.d/omarchy-lock-face
PathModified=/etc/pam.d/omarchy-lock-password
# LightDM's configuration: turning its XDMCP or VNC server on serves the
# `lightdm` login screen to remote users, and reconcile takes irlume's face
# lines out of that stack (pamwire/remote_seats.rs), which should happen
# before LightDM restarts with the change. A directory here fires on its
# entries changing. The vendor drop-in directories under /usr change by
# package updates, which the timer finds.
PathModified=/etc/lightdm/lightdm.conf
PathModified=/etc/lightdm/lightdm.conf.d
PathModified=/etc/xdg/lightdm/lightdm.conf.d
Unit=irlume-reconcile.service

[Install]
WantedBy=paths.target
